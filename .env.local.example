# Copy this file to .env.local and paste your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# TEACHING_MODEL=claude-opus-5-5   (claude-sonnet-5-5 is ~4x cheaper, a little less deep)
# HELPER_MODEL=claude-haiku-5-5
# TEACHING_EFFORT=low

# Natural read-aloud voice (optional; set ONE provider, otherwise the browser voice is used)
# ElevenLabs (most natural): https://elevenlabs.io  → Profile → API key; pick a voice in the Voice Library
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   (George; library voices need a paid ElevenLabs plan)
# ELEVENLABS_MODEL=eleven_multilingual_v2    (eleven_v3 is more expressive)
# ELEVENLABS_VOICE_ID_FR=
# Microsoft Azure Speech (cheaper, Nigerian-English voices): portal.azure.com → Speech service → Keys
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE_EN=en-NG-AbeoNeural
# AZURE_VOICE_FR=fr-FR-HenriNeural

# Background music under the preacher (optional). Without it, the browser plays its own soft keys.
# Epidemic Sound developer key (starts with epidemic_live_): https://developers.epidemicsound.com
# The free key is for prototyping only (50 downloads, no going live); launch needs an Epidemic partnership.
# EPIDEMIC_API_KEY=

# Which voice to use: kokoro | elevenlabs | azure | browser
# TTS_PROVIDER=kokoro
# Kokoro (free, open source). Set up once with: npm run voice:setup   then run: npm run voice
# KOKORO_URL=http://127.0.0.1:8880
# KOKORO_VOICE_EN=am_michael     (male: am_michael, am_onyx, am_fenrir, bm_george, bm_lewis, ...; blends: am_onyx:0.6+am_michael:0.4)
# KOKORO_VOICE_FR=ff_siwis       (the only French voice; a male English voice can also speak French, e.g. am_michael)
# KOKORO_SPEED=0.92
